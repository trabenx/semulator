{
  "run_settings": {
    "num_samples": 10,
    "output_dir": "./output",
    "master_seed": null, 
    "verbose": true
  },
  "image_settings": {
    "resolution": [512, 512],
    "bit_depth": 16,
    "magnification_range": [0.8, 1.5],
    "pixel_size_nm_at_1x": 10.0,
    "oversize_margin_factor": 0.25

  },
  "background": {
    "types_choices": ["flat", "gradient", "perlin", "composite"],
    "parameters": {
      "flat": { "intensity_range": [0.1, 0.3] }, 
      "gradient": { "type_choices": ["linear", "radial"], "angle_range": [0, 360], "start_intensity_range": [0.1, 0.2], "end_intensity_range": [0.2, 0.4] },
      "perlin": { "octaves_range": [4, 8], "persistence_range": [0.5, 0.7], "lacunarity_range": [2.0, 2.5], "scale_range": [50.0, 150.0], "contrast_range": [0.1, 0.3] },
      "composite": {
          "type1_choices": ["flat", "gradient", "perlin"], 
          "type2_choices": ["perlin", "gradient"],       
          "mode_choices": ["additive", "multiplicative", "overlay"], 
          "alpha_range": [0.3, 0.7] 
      }
    },
    "probability": 1.0 
  },
  "layering": {
    "num_layers_range": [1, 4], 
    "composition_mode": ["additive", "overwrite", "multiplicative"], 
    "randomize_order": true,
    "layers": [ 
      {
        "layer_id": "circles_grid_bright",
		"enabled": true,
        "probability": 0.15,
        "shape": "circle",
        "pattern": "grid",
        "intensity_range": [0.7, 0.95],
        "alpha_range": [0.9, 1.0],
        "shape_params": {
          "radius_range": [10, 30] 
        },
        "pattern_params": {
          "rows_range": [3, 8], "cols_range": [3, 8],
          "spacing_factor_range": [1.5, 3.0], 
          "jitter_fraction_range": [0.0, 0.1] 
        }
      },
      {
        "layer_id": "lines_faint_vertical",
		"enabled": true,
        "probability": 0.2,
        "shape": "line",
        "pattern": "full_span_vertical",
        "intensity_range": [0.4, 0.6],
        "alpha_range": [0.6, 0.9],
        "shape_params": {
          "thickness_range": [3, 40]
        },
        "pattern_params": {
          "count_range": [3, 15],
          "spacing_jitter_fraction_range": [0.1, 0.3]
        }
      },
      {
        "layer_id": "rounded_rects_hex",
		"enabled": true,
        "probability": 0.4,
        "shape": "rounded_rectangle",
        "pattern": "hex_grid",
        "intensity_range": [0.6, 0.9],
        "shape_params": {
          "width_range": [20, 40], "height_range": [15, 30], "corner_radius_fraction_range": [0.1, 0.4]
        },
        "pattern_params": { "spacing_factor_range": [1.8, 3.5], "jitter_fraction_range": [0.0, 0.15] }
      },
      {
        "layer_id": "polygons_dark_scatter",
		"enabled": true,
        "probability": 0.15,
        "shape": "polygon",
        "pattern": "random_scatter",
        "intensity_range": [0.1, 0.4],
        "alpha_range": [0.8, 1.0],
        "shape_params": {
           "radius_range": [15, 55],
           "num_sides_range": [5, 8],
           "irregularity_range": [0.0, 0.3]
        },
        "pattern_params": { "num_shapes_range": [5, 15] }
      },      
      {
        "layer_id": "ellipses_radial",
		"enabled": true,
        "probability": 0.15,
        "shape": "ellipse",
        "pattern": "radial_grid",
        "intensity_range": [0.5, 0.8],
        "alpha_range": [0.7, 1.0],
        "shape_params": { "width_range": [15, 40], "height_range": [10, 25], "rotation_range": [0, 180] },
        "pattern_params": { "rings_range": [2, 4], "shapes_per_ring_range": [5, 12], "radius_step_range": [40, 80], "jitter_fraction_range": [0.05, 0.2] }
      },
      {
        "layer_id": "polygons_grid_varied",
		"enabled": true,
        "probability": 0.20,
        "shape": "polygon",
        "pattern": "grid",
        "intensity_range": [0.4, 0.7],
        "alpha_range": [0.8, 1.0],
        "shape_params": {
          "radius_range": [15, 35],
          "num_sides_choices": [3, 4, 5, 6, 7, 8], 
          "irregularity_range": [0.0, 0.4], 
          "rotation_range": [0, 90]
        },
        "pattern_params": { "rows_range": [3, 6], "cols_range": [3, 6], "spacing_factor_range": [2.0, 4.0], "jitter_fraction_range": [0.0, 0.15] }
      },
      {
        "layer_id": "wavy_lines_horizontal",
		"enabled": true,
        "probability": 0.10,
        "shape": "wavy_line",
        "pattern": "full_span_horizontal",
        "intensity_range": [0.6, 0.9],
        "alpha_range": [0.8, 1.0],
        "shape_params": {
           "amplitude_range": [2, 8],
           "wavelength_range": [20, 60],
           "thickness_range": [6, 60]
        },
        "pattern_params": { "count_range": [4, 10], "spacing_jitter_fraction_range": [0.1, 0.3] }
      },
      {
        "layer_id": "predefined_scatter", 
		"enabled": true,
        "probability": 0.15,
        "shape_choices": ["H", "T", "L", "E", "I", "C", "U", "X", "Y"], 
        "pattern": "random_scatter",
        "intensity_range": [0.5, 0.9],
        "alpha_range": [0.85, 1.0],
        "shape_params": {
           "size_range": [50, 180], 
           "rotation_range": [-90, 90]
        },
        "pattern_params": { "num_shapes_range": [5, 12] }
      },
      {
        "layer_id": "sine_waves_horizontal",
        "enabled": true,
        "probability": 0.10, 
        "shape": "line", 
        "pattern": "sine_wave_horizontal", 
        "intensity_range": [0.6, 0.9], 
        "alpha_range": [0.8, 1.0],
        "shape_params": { "thickness_range": [4, 60]},
        "pattern_params": {
            "num_waves_range": [3, 10],        
            "vertical_spacing_range": [15, 50], 
            "vertical_jitter_fraction_range": [0.0, 0.15], 
            "amplitude_range": [5, 25],       
            "wavelength_range": [50, 200],    
            "points_per_wavelength_range": [15, 30] 
        },
        "__comment": "Horizontal sine wave patterns"
      },
	  {
        "layer_id": "photonic_crystal_holes",
        "enabled": true,
        "probability": 0.10,
        "shape": "circle", 
        "pattern": "hex_grid", 
        "intensity_range": [0.0, 0.1], 
        "alpha_range": [0.95, 1.0], 
        "shape_params": { "radius_range": [8, 40] },
        "pattern_params": { "spacing_factor_range": [1.8, 3.0], "jitter_fraction_range": [0.0, 0.08]  },
        "__comment": "Dark holes in hex pattern. Needs bright background/underlayer."
      }
    ]
  },
  "artifact_raffle": {
    "max_effects_per_image": 9, 
	"per_instance_geometric_mode": "local_affine",
    "categories": {
      "shape": [
        { "name": "edge_ripple", "probability": 0.40, "params": {"amplitude_range": [0.8, 3.5], "frequency_factor_range": [8, 25], "noise_factor_range": [0.6, 1.8]} },
        { "name": "breaks_holes", "probability": 0.25, "params": {"count_range": [1, 6], "size_fraction_range": [0.08, 0.30], "hole_probability": 0.5} },
        { "name": "local_elastic", "probability": 0.15, "params": {"alpha_range": [8, 30], "sigma_range": [2, 5], "grid_scale": 3}},
        { "name": "contour_smoothing", "probability": 0.10, "params": {"kernel_size_range": [3, 5]} },
        { "name": "local_brightness", "probability": 0.25, "params": {"contrast_range": [0.08, 0.3], "scale_range": [10, 30]}},
        { "name": "etch_bias", "probability": 0.35, "params": {"amount_range": [-2.5, 2.5]} },
        { "name": "local_affine", "probability": 0.30, "params": { "max_scale_delta_range": [0.01, 0.05],  "max_rotation_deg_range": [1, 5], "max_shear_deg_range": [1, 5], "max_translate_fraction_range": [0.01, 0.05]}},
        { "name": "shape_border", "probability": 0.65, "params": { "thickness_range": [1, 6], "intensity_factor_range": [1.2, 2.5] } },
		{ "name": "corner_rounding", "probability": 0.75, "params": { "kernel_size_range": [3, 13], "shape_choices": ["ellipse", "rect"], "operation_choices": ["open", "close", "close_open", "open_close"]} }
      ],
      "geometric": [
         { "name": "affine", "probability": 0.4, "params": {"max_scale_delta": 0.1, "max_rotation_deg": 10, "max_shear_deg": 5, "max_translate_fraction": 0.05} },
         { "name": "elastic", "probability": 0.3, "params": {"alpha_range": [30, 80], "sigma_range": [4, 9], "grid_scale": 4} }
      ],
      "instrument": [
        { "name": "psf_blur", "probability": 0.9, "params": {"sigma_range": [0.6, 1.8], "astigmatism_ratio_range": [1.0, 1.6], "angle_range": [0, 180]} },
        { "name": "defocus_blur", "probability": 0.2, "params": {"max_radius_range": [1, 4], "gradient_angle_range": [0, 360]}}, 
        { "name": "charging", "probability": 0.15, "params": {"intensity_range": [0.05, 0.25], "radius_range": [3, 10], "length_factor_range": [5, 30], "threshold_range": [0.7, 0.9]} },
        { "name": "topographic_shading", "probability": 0.5, "params": {"strength_range": [0.2, 0.6], "light_angle_deg_range": [0, 360], "height_scale_range": [30, 100], "use_layer_height_probability": 0.4 } }, 
        { "name": "gradient_illumination", "probability": 0.1, "params": {"max_delta_range": [0.1, 0.3], "angle_range": [0, 360]}},
        { "name": "striping_smearing", "probability": 0.05, "params": {"strength_range": [0.01, 0.05], "direction": ["h", "v"]}}, 
        { "name": "fixed_pattern_noise", "probability": 0.1, "params": {"scale_range": [50, 150], "strength_range": [0.01, 0.04]} },
        { "name": "edge_brightness", "probability": 0.75, "params": { "strength_range": [0.15, 0.45], "thickness_range": [0.8, 2.0], "low_thresh_factor_range": [0.05, 0.15], "high_thresh_factor_range": [0.2, 0.4]}}
	  ],
      "noise": [
        { "name": "gaussian", "probability": 0.8, "params": {"sigma_range": [0.01, 0.05]} },
        { "name": "poisson", "probability": 0.6, "params": {"scale_range": [0.05, 0.2]} }, 
        { "name": "salt_pepper", "probability": 0.1, "params": {"probability_range": [0.001, 0.01]} },
        { "name": "sem_texture", "probability": 0.85, "params": {"scale_range": [10, 40], "octaves_range": [4, 7], "contrast_range": [0.04, 0.12], "anisotropy_range":[1.0, 1.5]} },
        { "name": "quantization", "probability": 0.1, "params": {"target_bits_range": [6, 12]}}, 
        { "name": "blur_noise", "probability": 0.4, "params": {"sigma_range": [0.5, 1.0]}}
      ]
    }
  },
  "output_options": {
    "save_intermediate": true,
    "save_masks": true,
    "save_visualizations": true,
    "save_gifs": true,
    "save_overlays": true,
    "save_metadata": true,
    "save_config": true,
    "save_warp_field": true,
    "save_noise_map": true,
    "save_hashes": false,
    "save_defect_masks": true,
    "save_per_layer_renders": true,
    "save_bounding_boxes": true,
    "save_semantic_map": true,
    "save_topography_height_map": true,
    "save_extra_intermediate": true,
    "save_layer_order_map": true,
    "save_clean_layer_renders": true,
	"save_debug_oversized_warps": true,
	"save_debug_composition_steps": true,
    "save_shape_type_semantic_mask": true,
    "include_artifact_params_in_metadata": true,
    "output_formats": {
      "final_image": "tif",
      "instance_mask": "tif"
    }
  }
}